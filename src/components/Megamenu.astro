---
// Rebuild of the QuadMenu megamenu (theme custom_theme_1) from rescate-visual/menu.
// Desktop (≥1025px): horizontal bar, full-width black dropdowns with vertical tabs.
// Mobile: off-canvas panel from the right with the same items as an accordion.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { menu, redes } from '../data/sitio';
import piramide from '../assets/piramide.svg';

// accounts need Supabase; without it "Ingresar" only announces them
const conCuentas = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY);

const guias = (await getCollection('guias', ({ data }) => import.meta.env.DEV || !data.borrador))
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));
---

<nav class="megamenu" aria-label="Principal">
  <button class="megamenu__abrir" type="button" aria-expanded="false" aria-controls="megamenu-panel">
    <span class="visualmente-oculto">Abrir menú</span>
    <span class="hamburguesa" aria-hidden="true"><span></span><span></span><span></span></span>
  </button>

  <div class="megamenu__panel" id="megamenu-panel">
    <ul class="megamenu__lista">
      {menu.map((item) => (
        <li class={`item item--${item.id}${item.tipo ? ` item--${item.tipo}` : ''}`} data-item>
          <button class="item__boton" type="button" aria-expanded="false" aria-controls={`desplegable-${item.id}`}>
            {item.tipo === 'ingresar'
              ? <span class="item__avatar" aria-hidden="true"><span class="icono icono-admin-users"></span></span>
              : <span class={`icono icono-${item.icono} item__icono`} aria-hidden="true"></span>}
            <span class={item.tipo === 'redes' ? 'visualmente-oculto' : 'item__textos'}>
              <span class="item__titulo">
                {item.titulo}
                {item.insignia && <span class="insignia" aria-hidden="true">{item.insignia}</span>}
              </span>
              {item.subtitulo && <span class="item__subtitulo">{item.subtitulo}</span>}
            </span>
            {item.tipo !== 'redes' && <span class="item__flecha" aria-hidden="true"></span>}
          </button>

          <div class="desplegable" id={`desplegable-${item.id}`}>
            {item.pestanas && (
              <div class="desplegable__interior">
                <div class="pestanas" role="tablist" aria-orientation="vertical" aria-label={item.titulo}>
                  {item.pestanas.map((p, i) => (
                    <button
                      class="pestana" type="button" role="tab"
                      id={`pestana-${item.id}-${i}`} aria-controls={`panel-${item.id}-${i}`}
                      aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
                    >
                      {p.icono && <span class={`icono icono-${p.icono} pestana__icono`} aria-hidden="true"></span>}
                      <span class="pestana__textos">
                        <span class="pestana__titulo">{p.titulo}</span>
                        {p.subtitulo && <span class="pestana__subtitulo">{p.subtitulo}</span>}
                      </span>
                      <span class="icono icono-flecha-derecha pestana__flecha" aria-hidden="true"></span>
                    </button>
                  ))}
                </div>
                {item.pestanas.map((p, i) => (
                  <div class="panel" role="tabpanel" id={`panel-${item.id}-${i}`} aria-labelledby={`pestana-${item.id}-${i}`} hidden={i !== 0}>
                    {p.enlaces && (
                      <ul class="panel__enlaces">
                        {p.enlaces.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
                      </ul>
                    )}
                    {p.playlist && (
                      <iframe
                        class="panel__spotify" title={`Playlist ${p.titulo} en Spotify`}
                        data-src={`https://open.spotify.com/embed/playlist/${p.playlist}?theme=0`}
                        width="100%" height="380" loading="lazy"
                        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                      ></iframe>
                    )}
                    {!p.enlaces && !p.playlist && <p class="panel__vacio">En preparación.</p>}
                  </div>
                ))}
                {item.id === 'antes-que-todo' && (
                  <aside class="desplegable__lateral">
                    <p>Enlaza tu red social favorita</p>
                    <ul class="redes">
                      {redes.map((r) => (
                        <li><a href={r.url} rel="noopener" target="_blank"><span class={`icono icono-${r.icono}`} aria-hidden="true"></span><span class="visualmente-oculto">{r.nombre}</span></a></li>
                      ))}
                    </ul>
                    <Image src={piramide} alt="" width={260} class="desplegable__piramide" />
                  </aside>
                )}
              </div>
            )}

            {item.tipo === 'redes' && (
              <ul class="redes redes--menu">
                {redes.map((r) => (
                  <li><a href={r.url} rel="noopener" target="_blank"><span class={`icono icono-${r.icono}`} aria-hidden="true"></span><span class="visualmente-oculto">{r.nombre}</span></a></li>
                ))}
              </ul>
            )}

            {item.tipo === 'ingresar' && (
              <div class="desplegable__interior desplegable__interior--aviso">
                {conCuentas ? (
                  <div class="ingresar" data-ingresar>
                    <form data-ingresar-form novalidate>
                      <p>Ingresa con tu email: te enviamos un enlace para entrar, sin contraseña.</p>
                      <label for="ingresar-email" class="visualmente-oculto">Email</label>
                      <div class="ingresar__fila">
                        <input id="ingresar-email" type="email" placeholder="Email" required autocomplete="email" />
                        <button type="submit">Enviarme el enlace</button>
                      </div>
                    </form>
                    <div data-ingresar-sesion hidden>
                      <p>Ingresaste como <strong data-ingresar-email></strong>.</p>
                      <button type="button" data-ingresar-salir>Cerrar sesión</button>
                    </div>
                    <p class="ingresar__aviso" role="status" data-ingresar-aviso></p>
                  </div>
                ) : (
                  <p>Próximamente podrás ingresar con tu cuenta.</p>
                )}
              </div>
            )}

            {item.tipo === 'guias' && (
              <div class="desplegable__interior desplegable__interior--guias">
                {guias.length ? (
                  <ul class="guias-menu">
                    {guias.map((g) => (
                      <li>
                        <a href={`/guias/${g.id}/`}>
                          {g.data.molecula && <Image src={g.data.molecula} alt="" width={120} class="guias-menu__molecula" />}
                          <span>{g.data.titulo}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : <p class="panel__vacio">En preparación.</p>}
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  /* ---------- shared ---------- */
  .megamenu { font-family: var(--nd-fuente-menu); }
  .megamenu ul { list-style: none; margin: 0; padding: 0; }
  .item__boton {
    display: flex; align-items: center; gap: 0;
    font: inherit; color: var(--nd-negro); background: none; border: 0; cursor: pointer;
    text-align: left; position: relative;
  }
  .item__icono { font-size: 19px; color: var(--nd-morado-icono); padding-right: 19px; width: auto; box-sizing: content-box; transition: color .1s ease-in; }
  .item__icono:hover, .item__boton:hover .item__icono { animation: nd-rebote 1s var(--nd-curva); }
  .item__textos { display: flex; flex-direction: column; line-height: 1.15; }
  .item__titulo { font-weight: 700; font-size: 16px; position: relative; }
  .item__subtitulo { font-size: 12.8px; font-weight: 700; color: #707070; }
  .item[data-abierto] .item__subtitulo { color: var(--nd-verde-neon); animation: nd-pulso 1s var(--nd-curva); }
  .insignia {
    position: absolute; left: 50%; top: -1.75em; transform: translateX(-50%);
    background: var(--nd-rosado); color: #fff; font-size: 9px; line-height: 1; padding: 3px 10px 4px;
    animation: nd-columpio 1s var(--nd-curva) 1;
  }
  .insignia::after { /* little tail of the bubble */
    content: ''; position: absolute; left: 50%; bottom: -4px; margin-left: -4px;
    border: 4px solid transparent; border-top-color: var(--nd-rosado); border-bottom: 0;
  }
  .item__flecha::before { content: '\f347'; font: 9px/1 'dashicons'; margin-left: 8px; color: var(--nd-gris-600); }
  .item[data-abierto] .item__flecha::before { content: '\f335'; font-size: 13px; color: #fff; }
  .item__avatar {
    width: 46px; height: 46px; border-radius: 50%; background: #c8c8c8; margin-right: 16px;
    display: grid; place-items: center; color: #fff; font-size: 30px; overflow: hidden;
  }
  .item__avatar .icono { font-size: 34px; width: 34px; height: 34px; margin-top: 8px; }

  .pestanas { display: flex; flex-direction: column; gap: 15px; }
  .pestana {
    display: flex; align-items: center; width: 100%; min-height: 48px;
    padding: 12px 16px; border: 0; background: var(--nd-gris-700); cursor: pointer;
    font: 400 15px var(--nd-fuente-menu); text-align: left; color: var(--nd-verde-neon);
    transition: background .2s linear;
  }
  .pestana__icono { color: var(--nd-morado); font-size: 17px; width: 36px; flex: none; }
  .pestana__icono:hover, .pestana:hover .pestana__icono { animation: nd-rebote 1s var(--nd-curva); }
  .pestana__textos { display: flex; flex-direction: column; flex: 1; line-height: 1.2; }
  .pestana__subtitulo { font-size: 12px; color: #c6c6c6; }
  .pestana__flecha { font-size: 10px; color: var(--nd-verde-neon); }
  .pestana[aria-selected='true'] { background: var(--nd-gris-300); }
  .pestana[aria-selected='true'] .pestana__titulo { color: var(--nd-morado); }
  .pestana[aria-selected='true'] .pestana__subtitulo { color: #515151; }
  .pestana[aria-selected='true'] .pestana__flecha { color: var(--nd-morado); }

  .panel__enlaces a {
    display: block; padding: 12px 15px; color: var(--nd-verde-neon); text-decoration: none;
    font: 400 15px var(--nd-fuente-menu); border-bottom: 1px solid #fff; transition: color .2s linear;
  }
  .panel__enlaces li:last-child a { border-bottom: 0; }
  .panel__enlaces a:hover, .panel__enlaces a:focus-visible { color: #fff; }
  .panel__vacio { color: #c6c6c6; font-size: 15px; padding: 12px 15px; margin: 0; }
  .panel__spotify { border: 0; border-radius: 12px; display: block; background: var(--nd-gris-900); }

  .ingresar { max-width: 560px; }
  .ingresar p { margin: 0 0 12px; }
  .ingresar__fila { display: flex; }
  .ingresar input { flex: 1; min-width: 0; height: 46px; padding: 0 14px; border: 0; font: 300 15px var(--nd-fuente-cuerpo); }
  .ingresar button { height: 46px; padding: 0 18px; border: 0; cursor: pointer; background: var(--nd-verde-acento); color: #fff; font: 500 14px var(--nd-fuente-botones); }
  .ingresar button:hover { filter: brightness(1.1); }
  .ingresar button:disabled { opacity: .6; cursor: wait; }
  .ingresar strong { color: #fff; }
  .ingresar__aviso { color: var(--nd-verde-neon); min-height: 1.4em; }
  @media (max-width: 1024px) { .ingresar__fila { flex-direction: column; gap: 8px; } }

  .redes { display: flex; flex-wrap: wrap; gap: 8px; }
  .redes a { display: grid; place-items: center; width: 36px; height: 36px; color: var(--nd-morado-icono); text-decoration: none; font-size: 20px; }
  .redes a:hover { color: var(--nd-verde-neon); }

  .guias-menu { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; }
  .guias-menu a { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 16px; background: var(--nd-gris-700); color: var(--nd-verde-neon); text-decoration: none; font-size: 15px; text-align: center; }
  .guias-menu a:hover { background: var(--nd-gris-300); color: var(--nd-morado); }
  .guias-menu__molecula { filter: invert(1) brightness(.85); width: 90px; height: auto; }
  .guias-menu a:hover .guias-menu__molecula { filter: none; }

  @keyframes nd-rebote { 0%, 20%, 53%, 80%, 100% { transform: translateY(0); } 40%, 43% { transform: translateY(-8px); } 70% { transform: translateY(-4px); } 90% { transform: translateY(-2px); } }
  @keyframes nd-pulso { 0% { transform: scale(1); } 50% { transform: scale(1.06); } 100% { transform: scale(1); } }
  @keyframes nd-columpio { 20% { transform: translateX(-50%) rotate(15deg); } 40% { transform: translateX(-50%) rotate(-10deg); } 60% { transform: translateX(-50%) rotate(5deg); } 80% { transform: translateX(-50%) rotate(-5deg); } 100% { transform: translateX(-50%) rotate(0); } }

  /* ---------- desktop ---------- */
  @media (min-width: 1025px) {
    .megamenu__abrir { display: none; }
    .megamenu__lista { display: flex; align-items: stretch; justify-content: flex-end; height: 70px; }
    .item { display: flex; }
    .item__boton { padding: 0 15px; height: 60px; margin-top: 10px; transition: background .2s linear; }
    /* glow of the main items: .sombramenu in the WordPress additional CSS */
    .item__textos { text-shadow: var(--nd-resplandor-blanco); mix-blend-mode: luminosity; }
    .item__boton:hover .item__textos { text-shadow: none; mix-blend-mode: normal; }
    .item[data-abierto] > .item__boton { background: var(--nd-gris-900); color: #fff; }
    .item[data-abierto] .item__textos { text-shadow: none; mix-blend-mode: normal; }
    .item[data-abierto] .item__icono { color: var(--nd-verde-neon); }

    .desplegable {
      position: absolute; left: 0; right: 0; top: 80px; z-index: 50;
      background: var(--nd-negro); border: 10px solid #0c0c0c; box-shadow: var(--nd-sombra-desplegable);
      max-height: calc(100vh - 80px); overflow: auto;
      opacity: 0; visibility: hidden; transform: translateY(-10px);
      transition: transform .3s var(--nd-curva), opacity .3s ease-in, visibility 0s .3s;
    }
    .item[data-abierto] > .desplegable { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
    .desplegable__interior { display: grid; grid-template-columns: 330px 330px 1fr; gap: 0 30px; padding: 5px; align-items: start; }
    .desplegable__interior .pestanas { grid-column: 1; grid-row: 1 / span 20; }
    .panel { grid-column: 2; grid-row: 1; }
    .panel:has(.panel__spotify) { grid-column: 2 / span 2; max-width: 820px; }
    .desplegable__lateral { grid-column: 3; grid-row: 1; justify-self: end; text-align: center; color: #c6c6c6; font-size: 13px; padding: 10px 20px; }
    .desplegable__lateral .redes { justify-content: center; margin-bottom: 10px; }
    .desplegable__piramide { width: 220px; }
    .desplegable__interior--aviso, .desplegable__interior--guias { display: block; padding: 30px; color: #c6c6c6; }
    .item--redes { position: relative; }
    .item--redes .desplegable { left: auto; right: auto; top: 70px; border-width: 4px; padding: 6px; max-height: none; }
    .item--redes .item__icono { padding-right: 0; }
  }

  /* ---------- mobile: off-canvas ---------- */
  @media (max-width: 1024px) {
    .megamenu__abrir {
      position: relative; z-index: 70; width: 48px; height: 48px; margin-right: 5%;
      background: none; border: 0; cursor: pointer; display: grid; place-items: center;
    }
    .hamburguesa { display: grid; gap: 5px; width: 30px; }
    .hamburguesa span { height: 4px; background: var(--nd-morado-icono); border-radius: 2px; transition: transform .3s var(--nd-curva), opacity .2s; }
    .megamenu[data-abierto] .hamburguesa span { background: var(--nd-rosado); }
    .megamenu[data-abierto] .hamburguesa span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
    .megamenu[data-abierto] .hamburguesa span:nth-child(2) { opacity: 0; }
    .megamenu[data-abierto] .hamburguesa span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

    .megamenu__panel {
      position: fixed; inset: 0 0 0 auto; z-index: 60; width: 82%; max-width: 90%;
      background: #fff; overflow-y: auto; padding: 90px 16px 32px;
      transform: translateX(100%); visibility: hidden;
      transition: transform .35s var(--nd-curva), visibility 0s .35s;
    }
    .megamenu[data-abierto] .megamenu__panel { transform: none; visibility: visible; transition-delay: 0s; }
    .megamenu[data-abierto]::before { /* dim the page behind the panel */
      content: ''; position: fixed; inset: 0; z-index: 55; background: rgba(0,0,0,.35);
    }
    .megamenu__lista { display: flex; flex-direction: column; }
    .item { border-bottom: 1px solid #eee; }
    .item__boton { width: 100%; padding: 14px 4px; }
    .item__flecha { margin-left: auto; }
    .item[data-abierto] .item__flecha::before { color: var(--nd-gris-600); }
    .insignia { position: static; transform: none; margin-left: 10px; vertical-align: 3px; animation: none; }
    .insignia::after { display: none; }
    .desplegable { display: none; padding: 0 0 14px; }
    .item[data-abierto] > .desplegable { display: block; }
    .desplegable__interior { display: flex; flex-direction: column; gap: 10px; background: var(--nd-negro); padding: 10px; }
    .pestanas { gap: 8px; }
    .panel { padding: 4px 0; }
    .desplegable__lateral { text-align: center; color: #c6c6c6; font-size: 13px; }
    .desplegable__lateral .redes { justify-content: center; }
    .desplegable__piramide { width: 160px; }
    .desplegable__interior--aviso, .desplegable__interior--guias { color: #c6c6c6; padding: 16px; }
    .item--redes .item__boton { display: none; }
    .item--redes .desplegable { display: block; padding: 0 0 8px; }
    .item--redes { order: -1; border: 0; }
    .redes--menu { justify-content: center; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  // "Ingresar": magic-link sign in with Supabase Auth
  const zona = document.querySelector<HTMLElement>('[data-ingresar]');
  if (zona && supabase) {
    const sb = supabase;
    const form = zona.querySelector<HTMLFormElement>('[data-ingresar-form]')!;
    const email = form.querySelector<HTMLInputElement>('input')!;
    const enviar = form.querySelector<HTMLButtonElement>('button')!;
    const sesion = zona.querySelector<HTMLElement>('[data-ingresar-sesion]')!;
    const aviso = zona.querySelector<HTMLElement>('[data-ingresar-aviso]')!;
    const titulo = document.querySelector<HTMLElement>('.item--ingresar .item__titulo')!;

    const mostrar = (correo: string | undefined) => {
      form.hidden = Boolean(correo);
      sesion.hidden = !correo;
      zona.querySelector('[data-ingresar-email]')!.textContent = correo ?? '';
      titulo.textContent = correo ? 'Mi cuenta' : 'Ingresar';
    };
    sb.auth.getSession().then(({ data }) => mostrar(data.session?.user.email));
    sb.auth.onAuthStateChange((_evento, s) => mostrar(s?.user.email));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!email.checkValidity()) { aviso.textContent = 'Escribe un email válido.'; return; }
      enviar.disabled = true;
      aviso.textContent = 'Enviando…';
      const { error } = await sb.auth.signInWithOtp({
        email: email.value.trim(),
        options: { emailRedirectTo: location.href.split('#')[0] },
      });
      enviar.disabled = false;
      aviso.textContent = error
        ? 'No pudimos enviar el enlace. Intenta de nuevo en un rato.'
        : 'Revisa tu correo: te enviamos un enlace para entrar.';
      if (error) console.error('signInWithOtp:', error);
    });
    zona.querySelector('[data-ingresar-salir]')!.addEventListener('click', async () => {
      await sb.auth.signOut();
      aviso.textContent = 'Cerraste sesión.';
    });
  }

  const ESCRITORIO = window.matchMedia('(min-width: 1025px)');

  for (const nav of document.querySelectorAll<HTMLElement>('.megamenu')) {
    const items = [...nav.querySelectorAll<HTMLElement>('[data-item]')];
    const abrirPanel = nav.querySelector<HTMLButtonElement>('.megamenu__abrir')!;
    let cierreDiferido: number | undefined;

    const cargarEmbeds = (zona: Element) => {
      zona.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((f) => {
        if (!f.closest('[hidden]') && !f.src) f.src = f.dataset.src!;
      });
    };
    const setItem = (item: HTMLElement, abierto: boolean) => {
      item.toggleAttribute('data-abierto', abierto);
      item.querySelector('.item__boton')!.setAttribute('aria-expanded', String(abierto));
      if (abierto) cargarEmbeds(item);
    };
    const cerrarTodos = (excepto?: HTMLElement) => items.forEach((i) => i !== excepto && setItem(i, false));

    for (const item of items) {
      const boton = item.querySelector<HTMLButtonElement>('.item__boton')!;
      let abiertoPorHover = 0;
      boton.addEventListener('click', () => {
        // the hover that precedes a mouse click already opened it: the click must not close it again
        if (Date.now() - abiertoPorHover < 600) return;
        const abrir = !item.hasAttribute('data-abierto');
        cerrarTodos(item);
        setItem(item, abrir);
      });
      // desktop: open on hover, like QuadMenu
      item.addEventListener('pointerenter', (e) => {
        if (!ESCRITORIO.matches || e.pointerType !== 'mouse') return;
        clearTimeout(cierreDiferido);
        if (!item.hasAttribute('data-abierto')) abiertoPorHover = Date.now();
        cerrarTodos(item);
        setItem(item, true);
      });
      item.addEventListener('pointerleave', (e) => {
        if (!ESCRITORIO.matches || e.pointerType !== 'mouse') return;
        cierreDiferido = window.setTimeout(() => setItem(item, false), 200);
      });

      // vertical tabs
      const pestanas = [...item.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const activar = (p: HTMLButtonElement, foco = false) => {
        for (const otra of pestanas) {
          const sel = otra === p;
          otra.setAttribute('aria-selected', String(sel));
          otra.tabIndex = sel ? 0 : -1;
          document.getElementById(otra.getAttribute('aria-controls')!)!.hidden = !sel;
        }
        if (foco) p.focus();
        cargarEmbeds(item);
      };
      pestanas.forEach((p, i) => {
        p.addEventListener('click', () => activar(p));
        p.addEventListener('pointerenter', (e) => { if (ESCRITORIO.matches && e.pointerType === 'mouse') activar(p); });
        p.addEventListener('keydown', (e) => {
          const destino = e.key === 'ArrowDown' ? pestanas[(i + 1) % pestanas.length]
            : e.key === 'ArrowUp' ? pestanas[(i - 1 + pestanas.length) % pestanas.length]
            : e.key === 'Home' ? pestanas[0] : e.key === 'End' ? pestanas[pestanas.length - 1] : null;
          if (destino) { e.preventDefault(); activar(destino, true); }
        });
      });
    }

    const setPanel = (abierto: boolean) => {
      nav.toggleAttribute('data-abierto', abierto);
      abrirPanel.setAttribute('aria-expanded', String(abierto));
      abrirPanel.querySelector('.visualmente-oculto')!.textContent = abierto ? 'Cerrar menú' : 'Abrir menú';
      document.documentElement.style.overflow = abierto ? 'hidden' : '';
    };
    abrirPanel.addEventListener('click', () => setPanel(!nav.hasAttribute('data-abierto')));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const abierto = items.find((i) => i.hasAttribute('data-abierto'));
      if (abierto) { setItem(abierto, false); abierto.querySelector<HTMLButtonElement>('.item__boton')!.focus(); }
      else if (nav.hasAttribute('data-abierto')) { setPanel(false); abrirPanel.focus(); }
    });
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target as Node)) cerrarTodos();
      // click on the dimmed backdrop (outside the panel) closes the off-canvas
      if (nav.hasAttribute('data-abierto') && !nav.querySelector('.megamenu__panel')!.contains(e.target as Node) && !abrirPanel.contains(e.target as Node)) setPanel(false);
    });
    ESCRITORIO.addEventListener('change', () => { setPanel(false); cerrarTodos(); });
  }
</script>
