---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { publicado } from '../../lib/contenido';

const guias = (await getCollection('guias', publicado)).sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));
---

<Base titulo="Guías" descripcion="Guías completas sobre psicoactivos: historia, efectos, mitos y mitigación de daños." suscripcion={false}>
  <section class="guias contenedor">
    <h1>Guías</h1>
    <ul>
      {guias.map((g) => (
        <li>
          <a href={`/guias/${g.id}/`} class="guia-tarjeta">
            {g.data.imagen && <Image src={g.data.imagen} alt="" width={700} class="guia-tarjeta__fondo" />}
            <span class="guia-tarjeta__titulo">{g.data.titulo}</span>
            {g.data.borrador && <span class="guia-tarjeta__estado">Borrador</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .guias { padding: 40px 0 100px; }
  .guias h1 { font: 300 var(--nd-hero-titulo)/1 var(--nd-fuente-hero); margin: 0 0 30px; color: var(--nd-gris-800); }
  .guias ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .guia-tarjeta { position: relative; display: flex; align-items: flex-end; min-height: 260px; padding: 20px; overflow: hidden; background: var(--nd-negro); text-decoration: none; isolation: isolate; }
  .guia-tarjeta__fondo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; opacity: .75; transition: filter 3s var(--nd-curva); }
  .guia-tarjeta:hover .guia-tarjeta__fondo { filter: var(--nd-filtro-psicodelico); }
  .guia-tarjeta__titulo { color: #fff; font: 300 32px/1 var(--nd-fuente-hero); text-shadow: var(--nd-resplandor-cian); }
  .guia-tarjeta__estado { position: absolute; top: 12px; right: 12px; background: var(--nd-rosado); color: #fff; font: 500 12px var(--nd-fuente-menu); padding: 2px 8px; }
</style>
